# Ignore node_modules (will be installed inside container)
node_modules
npm-debug.log
yarn-error.log
pnpm-debug.log

# Logs
logs
*.log
*.log.*

# Environment files (don’t bake secrets into the image)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS / editor files
.DS_Store
*.swp
*.swo
*.swm
*.swn
Thumbs.db

# Git / version control
git
gitignore
gitattributes

# Next.js build output
next/cache
out

# Test / coverage
coverage
*.spec.js
*.test.js
*.spec.ts
*.test.ts
jest.config.js
